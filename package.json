{
	"name": "status",
	"version": "1.0.0",
	"description": "Status page for pretendo",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"start": "node --env-file=.env --enable-source-maps .output/server/index.mjs",
		"build": "prisma generate && nuxt build",
		"prepare": "prisma generate && nuxt prepare",
		"dev": "prisma generate && nuxt dev",
		"migration:create": "prisma migrate dev --create-only && prisma generate",
		"migration:deploy": "prisma migrate deploy",
		"migration:reset": "prisma migrate reset",
		"typecheck": "prisma generate && nuxt typecheck",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"@nuxt/eslint": "^1.3.0",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/icon": "^2.5.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@vueuse/core": "^14.4.0",
		"croner": "^10.0.1",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.5",
		"node-cache": "^5.1.2",
		"nuxt": "^4.5.2",
		"pg": "^8.23.0",
		"rate-limiter-flexible": "^11.2.0",
		"reka-ui": "^2.10.3",
		"vue": "^3.5.13",
		"vue-router": "^5.2.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@iconify-json/fa7-brands": "^1.2.4",
		"@iconify-json/ph": "^1.2.2",
		"@pretendonetwork/eslint-config": "^0.1.4",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"eslint-plugin-vue": "^10.0.0",
		"prisma": "^7.9.1",
		"vue-tsc": "^3.3.10"
	},
	"allowScripts": {
		"esbuild@0.27.7": true,
		"esbuild@0.28.2": true,
		"unrs-resolver@1.12.2": true,
		"vue-demi@0.14.10": true,
		"@prisma/engines@7.9.1": true,
		"prisma@7.9.1": true
	}
}
