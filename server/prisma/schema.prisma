generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum IncidentType {
  Incident
  Notice
  Maintenance
}

model IncidentPost {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  title String
  body  String?

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("incident_posts")
}

model Incident {
  id         String       @id
  startedAt  DateTime     @default(now()) @map("started_at")
  resolvedAt DateTime?    @map("resolved_at")
  showAt     DateTime     @default(now()) @map("show_at")
  type       IncidentType @default(Incident)

  posts IncidentPost[]

  @@map("incidents")
}

model CheckResult {
  id        BigInt @id @default(autoincrement())
  checkId   String @map("check_id")
  serviceId String @map("service_id")

  checkedAt  DateTime @map("checked_at")
  durationMs Int      @map("duration_ms")
  success    Boolean

  @@map("check_results")
}

enum BucketResolution {
  Hour
  Day
}

model CheckResultBucket {
  id        BigInt @id @default(autoincrement())
  checkId   String @map("check_id")
  serviceId String @map("service_id")

  timestamp  DateTime
  resolution BucketResolution

  totalChecks   Int @map("total_checks")
  successChecks Int @map("successful_checks")

  @@unique([checkId, resolution, timestamp])
  @@map("check_result_buckets")
}
